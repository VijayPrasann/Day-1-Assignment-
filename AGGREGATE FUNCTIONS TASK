-- =========================================
-- PART 1: AGGREGATE FUNCTIONS TASK
-- =========================================

-- 1. Create orders table
CREATE TABLE orders (
    order_id INT PRIMARY KEY,
    product_name VARCHAR(50),
    order_price DECIMAL(10,2)
);

-- 2. Insert records
INSERT INTO orders VALUES
(1, 'Laptop', 50000),
(2, 'Mobile', 20000),
(3, 'Laptop', 45000),
(4, 'Keyboard', 1500),
(5, 'Mouse', 500),
(6, 'Mobile', 25000);

-- Display all records
SELECT * FROM orders;

-- 3. COUNT() - Count total orders
SELECT COUNT(*) AS total_orders
FROM orders;

-- 4. SUM() - Find total order prices
SELECT SUM(order_price) AS total_price
FROM orders;

-- 5. AVG() - Find average order price
SELECT AVG(order_price) AS average_price
FROM orders;

-- 6. GROUP BY - Show total sales by product
SELECT product_name, SUM(order_price) AS total_sales
FROM orders
GROUP BY product_name;

-- 7. MAX() and MIN() - Find highest and lowest price
SELECT MAX(order_price) AS maximum_price,
       MIN(order_price) AS minimum_price
FROM orders;

-- 8. ORDER BY - Sort total sales in descending order
SELECT product_name, SUM(order_price) AS total_sales
FROM orders
GROUP BY product_name
ORDER BY total_sales DESC;


-- =========================================
-- PART 2: BUILT-IN FUNCTIONS TASK
-- =========================================

-- 1. Create events table
CREATE TABLE events (
    id INT PRIMARY KEY,
    event_name VARCHAR(50),
    event_date DATE
);

-- 2. Insert events with different dates
INSERT INTO events VALUES
(1, 'Birthday', '2026-01-15'),
(2, 'Meeting', '2026-03-20'),
(3, 'Wedding', '2026-06-10'),
(4, 'Workshop', '2026-08-25'),
(5, 'Conference', '2026-11-15');

-- Display all records
SELECT * FROM events;

-- 3. NOW() - Display current date and time
SELECT NOW() AS current_date_time;

-- 4. DATE_FORMAT() - Format event date
SELECT event_name,
       DATE_FORMAT(event_date, '%d-%m-%Y') AS formatted_date
FROM events;

-- 5. YEAR() and MONTH() - Extract year and month
SELECT event_name,
       YEAR(event_date) AS event_year,
       MONTH(event_date) AS event_month
FROM events;

-- 6. CONCAT() - Combine event name and date
SELECT CONCAT(event_name, ' - ', event_date) AS event_details
FROM events;
