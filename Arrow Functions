
// 1. Print Numbers from 1 to 10
let printNumbers = () => {
    for (let i = 1; i <= 10; i++) {
        console.log(i);
    }
};
printNumbers();


// 2. Print Numbers from 10 to 1
let reverseNumbers = () => {
    for (let i = 10; i >= 1; i--) {
        console.log(i);
    }
};
reverseNumbers();


