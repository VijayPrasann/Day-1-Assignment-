// 13. Reverse a Number
let reverseNumber = (n) => {
    let rev = 0;

    while (n > 0) {
        let rem = n % 10;
        rev = rev * 10 + rem;
        n = Math.floor(n / 10);
    }

    console.log("Reverse =", rev);
};
reverseNumber(1234);


// 14. Sum of Digits
let sumOfDigits = (n) => {
    let sum = 0;

    while (n > 0) {
        let rem = n % 10;
        sum = sum + rem;
        n = Math.floor(n / 10);
    }

    console.log("Sum of Digits =", sum);
};
sumOfDigits(1234);


// 15. Count Number of Digits
let countDigits = (n) => {
    let count = 0;

    if (n == 0) {
        count = 1;
    } else {
        while (n > 0) {
            count++;
            n = Math.floor(n / 10);
        }
    }

    console.log("Number of Digits =", count);
};
countDigits(12345);


// 16. Check Palindrome Number
let palindrome = (n) => {
    let temp = n;
    let rev = 0;

    while (temp > 0) {
        let rem = temp % 10;
        rev = rev * 10 + rem;
        temp = Math.floor(temp / 10);
    }

    if (rev == n) {
        console.log(n + " is Palindrome");
    } else {
        console.log(n + " is Not Palindrome");
    }
};
palindrome(121);


// 17. Find Factors of a Number
let factors = (n) => {
    for (let i = 1; i <= n; i++) {
        if (n % i == 0) {
