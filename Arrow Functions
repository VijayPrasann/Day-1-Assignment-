        }
    }
};
factors(12);


// 18. Find Power of a Number
let power = (base, exponent) => {
    let result = 1;

    for (let i = 1; i <= exponent; i++) {
        result = result * base;
    }

    console.log("Power =", result);
};
power(2, 5);


// 19. Find Largest Digit
let largestDigit = (n) => {
    let largest = 0;

    while (n > 0) {
        let rem = n % 10;

        if (rem > largest) {
            largest = rem;
        }

        n = Math.floor(n / 10);
    }

    console.log("Largest Digit =", largest);
};
largestDigit(5832);


// 20. Find Smallest Digit
let smallestDigit = (n) => {
    let smallest = 9;

    while (n > 0) {
        let rem = n % 10;

        if (rem < smallest) {
            smallest = rem;
        }

        n = Math.floor(n / 10);
    }

    console.log("Smallest Digit =", smallest);
};
smallestDigit(5832);
