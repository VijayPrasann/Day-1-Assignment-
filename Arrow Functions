// 6. Multiplication Table
let multiplicationTable = (n) => {
    for (let i = 1; i <= 10; i++) {
        console.log(n + " x " + i + " = " + (n * i));
    }
};
multiplicationTable(5);


// 7. Factorial of a Number
let factorial = (n) => {
    let fact = 1;

    for (let i = 1; i <= n; i++) {
        fact = fact * i;
    }

    console.log("Factorial =", fact);
};
factorial(5);


// 8. Check Prime Number
let checkPrime = (n) => {
    let count = 0;

    for (let i = 1; i <= n; i++) {
        if (n % i == 0) {
            count++;
        }
    }

    if (n > 1 && count == 2) {
        console.log(n + " is Prime");
    } else {
        console.log(n + " is Not Prime");
    }
};
checkPrime(7);


// 9. Print Prime Number Series
let primeSeries = () => {
    for (let n = 2; n <= 50; n++) {
        let count = 0;

        for (let i = 1; i <= n; i++) {
            if (n % i == 0) {
                count++;
            }
        }

        if (count == 2) {
            console.log(n);
        }
    }
};
primeSeries();


// 10. Check Armstrong Number
let checkArmstrong = (n) => {
    let temp = n;
    let sum = 0;
    let digits = n.toString().length;

    while (temp > 0) {
        let rem = temp % 10;
        sum = sum + rem ** digits;
        temp = Math.floor(temp / 10);
    }

    if (sum == n) {
        console.log(n + " is Armstrong Number");
    } else {
        console.log(n + " is Not Armstrong Number");
    }
};
checkArmstrong(153);


