
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bootstrap Assignment</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body>

    <!-- PROGRAM 1: EMPLOYEE TABLE -->

    <div class="container mt-5">

        <h2 class="text-center mb-4">Employee Details</h2>

        <div class="table-responsive">

            <table class="table table-bordered table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Department</th>
                        <th>Salary</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>101</td>
                        <td>Vijay</td>
                        <td>IT</td>
                        <td>25000</td>
                    </tr>

                    <tr>
                        <td>102</td>
                        <td>Rahul</td>
                        <td>HR</td>
                        <td>30000</td>
                    </tr>

                    <tr>
                        <td>103</td>
                        <td>Arun</td>
                        <td>Finance</td>
                        <td>28000</td>
                    </tr>

                    <tr>
                        <td>104</td>
                        <td>Priya</td>
                        <td>Marketing</td>
                        <td>35000</td>
                    </tr>

                    <tr>
                        <td>105</td>
                        <td>Ajay</td>
                        <td>Development</td>
                        <td>40000</td>
                    </tr>

                    <tr>
                        <td>106</td>
                        <td>Divya</td>
                        <td>Testing</td>
                        <td>32000</td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>


    <hr class="my-5">


    <!-- PROGRAM 2: TRAINING INSTITUTE PAGE -->


    <!-- Responsive Navbar -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container">

            <a class="navbar-brand" href="#">ABC Institute</a>

            <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMenu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="#home">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#courses">Courses</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact</a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- Main Heading -->

    <div class="container text-center mt-5" id="home">

        <h1 class="text-primary">Welcome to ABC Training Institute</h1>

        <p class="lead">
            Learn Programming and Build Your Future
        </p>

        <!-- Institute Image -->

        <img src="https://placehold.co/1000x350/0d6efd/ffffff?text=ABC+Training+Institute"
            class="img-fluid rounded mt-3"
            alt="Training Institute">

    </div>


    <!-- About Institute -->

    <div class="container mt-5" id="about">

        <h2 class="text-center">About Our Institute</h2>

        <p class="text-center mt-3">
            ABC Training Institute provides quality technical education
            and practical training for students. We offer various
            programming courses, experienced trainers and placement
            support to help students build successful careers.
        </p>

    </div>


    <!-- Three Cards -->

    <div class="container mt-5" id="courses">

        <h2 class="text-center mb-4">Our Services</h2>

        <div class="row g-4">

            <!-- Card 1 -->

            <div class="col-md-4">

                <div class="card h-100 shadow">

                    <div class="card-body text-center">

                        <h4 class="card-title">Courses</h4>

                        <p class="card-text">
                            Python, Java, HTML, CSS, JavaScript,
                            React and SQL.
                        </p>

                        <a href="#contact" class="btn btn-primary">
                            View Courses
                        </a>

                    </div>

                </div>

            </div>


            <!-- Card 2 -->

            <div class="col-md-4">

                <div class="card h-100 shadow">

                    <div class="card-body text-center">

                        <h4 class="card-title">Trainers</h4>

                        <p class="card-text">
                            Learn from experienced trainers
                            with practical knowledge.
                        </p>

                        <a href="#contact" class="btn btn-success">
                            View Trainers
                        </a>

                    </div>

                </div>

            </div>


            <!-- Card 3 -->

            <div class="col-md-4">

                <div class="card h-100 shadow">

                    <div class="card-body text-center">

                        <h4 class="card-title">Placements</h4>

                        <p class="card-text">
                            Get placement guidance, interview
                            preparation and career support.
                        </p>

                        <a href="#contact" class="btn btn-warning">
                            View Placements
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Footer -->

    <footer class="bg-dark text-white text-center p-4 mt-5" id="contact">

        <h5>ABC Training Institute</h5>

        <p>Email: abc@gmail.com</p>

        <p>Phone: 9876543210</p>

        <p class="mb-0">
            Copyright 2026 ABC Institute. All Rights Reserved.
        </p>

    </footer>


    <hr class="my-5">


    <!-- PROGRAM 3: EMPLOYEE REGISTRATION FORM -->


    <div class="container mt-5 mb-5">

        <h2 class="text-center mb-4">
            Employee Registration Form
        </h2>

        <div class="row justify-content-center">

            <div class="col-md-6">

                <form>

                    <!-- Employee Name -->

                    <div class="mb-3">

                        <label class="form-label">
                            Employee Name
                        </label>

                        <input type="text"
                            class="form-control"
                            placeholder="Enter Employee Name">

                    </div>


                    <!-- Email -->

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <input type="email"
                            class="form-control"
                            placeholder="Enter Email">

                    </div>


                    <!-- Mobile Number -->

                    <div class="mb-3">

                        <label class="form-label">
                            Mobile Number
                        </label>

                        <input type="tel"
                            class="form-control"
                            placeholder="Enter Mobile Number">

                    </div>


                    <!-- Department Dropdown -->

                    <div class="mb-3">

                        <label class="form-label">
                            Department
                        </label>

                        <select class="form-select">

                            <option selected disabled>
                                Select Department
                            </option>

                            <option>IT</option>
                            <option>HR</option>
                            <option>Finance</option>
                            <option>Marketing</option>
                            <option>Development</option>

                        </select>

                    </div>


                    <!-- Gender -->

                    <div class="mb-3">

                        <label class="form-label">
                            Gender
                        </label>

                        <div class="form-check">

                            <input type="radio"
                                class="form-check-input"
                                name="gender"
                                id="male">

                            <label class="form-check-label"
                                for="male">
                                Male
                            </label>

                        </div>

                        <div class="form-check">

                            <input type="radio"
                                class="form-check-input"
                                name="gender"
                                id="female">

                            <label class="form-check-label"
                                for="female">
                                Female
                            </label>

                        </div>

                        <div class="form-check">

                            <input type="radio"
                                class="form-check-input"
                                name="gender"
                                id="other">

                            <label class="form-check-label"
                                for="other">
                                Other
                            </label>

                        </div>

                    </div>


                    <!-- Date of Joining -->

                    <div class="mb-3">

                        <label class="form-label">
                            Date of Joining
                        </label>

                        <input type="date"
                            class="form-control">

                    </div>


                    <!-- Submit Button -->

                    <button type="submit"
                        class="btn btn-primary w-100">

                        Submit

                    </button>

                </form>

            </div>

        </div>

    </div>


    <!-- Bootstrap JavaScript -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
