// Task 2: Product List
function Products() {
  return (
    <div>
      <h1>Product List</h1>

      <div className="products">
        <div className="card">
          <h2>Laptop</h2>
          <p>Price: ₹55,000</p>
        </div>

        <div className="card">
          <h2>Mobile</h2>
          <p>Price: ₹25,000</p>
