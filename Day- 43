
import { BrowserRouter, Routes, Route, Link, useNavigate } from "react-router-dom";
import "./index.css";

// Task 1: Home Page
function Home() {
  return (
    <div>
      <h1>Welcome to Home Page</h1>
      <p>This is the home page of my React website.</p>
    </div>
  );
}

// Task 1: About Page
function About() {
  return (
    <div>
      <h1>About Us</h1>
      <p>This website demonstrates React Router.</p>
    </div>
  );
}

// Task 1: Contact Page
function Contact() {
  return (
    <div>
      <h1>Contact Us</h1>
      <p>Email: support@example.com</p>
      <p>Phone: 9876543210</p>
      <p>Address: Chennai, Tamil Nadu</p>
    </div>
  );
