SELECT * FROM Product WHERE Price<1000;
SELECT * FROM Product WHERE Price>=1000;
SELECT * FROM Product WHERE Price<=1000;
```

## 3. Logical Operators

```sql
-- Employee
SELECT * FROM Employee WHERE Salary>20000 AND Salary<50000;
SELECT * FROM Employee WHERE Salary<20000 OR Salary>50000;
SELECT * FROM Employee WHERE NOT Salary=30000;

-- Customer
SELECT * FROM Customer WHERE CustomerID>1 AND CustomerID<5;
SELECT * FROM Customer WHERE CustomerID=1 OR CustomerID=5;
SELECT * FROM Customer WHERE NOT CustomerID=1;

-- Student
SELECT * FROM Student WHERE Marks>=50 AND Marks<=100;
SELECT * FROM Student WHERE Marks<35 OR Marks>90;
SELECT * FROM Student WHERE NOT Marks=80;

-- Staff
SELECT * FROM Staff WHERE Salary>20000 AND Salary<50000;
SELECT * FROM Staff WHERE Salary<20000 OR Salary>50000;
SELECT * FROM Staff WHERE NOT Salary=25000;

-- Product
SELECT * FROM Product WHERE Price>500 AND Price<5000;
SELECT * FROM Product WHERE Price<500 OR Price>5000;
SELECT * FROM Product WHERE NOT Price=1000;
```

## 4. Special Operators

```sql
-- Employee
SELECT * FROM Employee WHERE Salary IN (20000,30000,40000);
SELECT * FROM Employee WHERE Salary BETWEEN 20000 AND 50000;
SELECT * FROM Employee WHERE EmpName LIKE 'A%';
SELECT * FROM Employee WHERE Salary IS NULL;
SELECT * FROM Employee WHERE Salary IS NOT NULL;
SELECT * FROM Employee e WHERE EXISTS
(SELECT 1 FROM Employee e2 WHERE e2.EmpID=e.EmpID);

-- Customer
SELECT * FROM Customer WHERE CustomerID IN (1,2,3);
SELECT * FROM Customer WHERE CustomerID BETWEEN 1 AND 5;
SELECT * FROM Customer WHERE CName LIKE 'A%';
SELECT * FROM Customer WHERE Address IS NULL;
SELECT * FROM Customer WHERE Address IS NOT NULL;
SELECT * FROM Customer c WHERE EXISTS
(SELECT 1 FROM Customer c2 WHERE c2.CustomerID=c.CustomerID);

-- Student
SELECT * FROM Student WHERE Marks IN (60,70,80);
SELECT * FROM Student WHERE Marks BETWEEN 50 AND 100;
SELECT * FROM Student WHERE StudentName LIKE 'A%';
SELECT * FROM Student WHERE Marks IS NULL;
SELECT * FROM Student WHERE Marks IS NOT NULL;
SELECT * FROM Student s WHERE EXISTS
(SELECT 1 FROM Student s2 WHERE s2.RollNo=s.RollNo);

-- Staff
SELECT * FROM Staff WHERE Salary IN (20000,25000,30000);
SELECT * FROM Staff WHERE Salary BETWEEN 20000 AND 50000;
SELECT * FROM Staff WHERE SName LIKE 'R%';
SELECT * FROM Staff WHERE Email IS NULL;
SELECT * FROM Staff WHERE Email IS NOT NULL;
SELECT * FROM Staff s WHERE EXISTS
(SELECT 1 FROM Staff s2 WHERE s2.StaffID=s.StaffID);

-- Product
SELECT * FROM Product WHERE Price IN (500,1000,1500);
SELECT * FROM Product WHERE Price BETWEEN 500 AND 5000;
SELECT * FROM Product WHERE ProductName LIKE 'M%';
SELECT * FROM Product WHERE Price IS NULL;
SELECT * FROM Product WHERE Price IS NOT NULL;
SELECT * FROM Product p WHERE EXISTS
(SELECT 1 FROM Product p2 WHERE p2.ProductID=p.ProductID);
```

## 5. String Built-in Functions

```sql
-- Employee
SELECT UPPER(EmpName), LOWER(EmpName), LENGTH(EmpName) FROM Employee;

-- Customer
SELECT UPPER(CName), LOWER(CName), LENGTH(CName) FROM Customer;

-- Student
SELECT UPPER(StudentName), LOWER(StudentName), LENGTH(StudentName) FROM Student;

-- Staff
SELECT UPPER(SName), LOWER(SName), LENGTH(SName) FROM Staff;

-- Product
SELECT UPPER(ProductName), LOWER(ProductName), LENGTH(ProductName) FROM Product;

-- Other string functions
SELECT CONCAT('Hello',' ','World');
SELECT SUBSTRING('DATABASE',1,4);
SELECT TRIM('  MySQL  ');
SELECT REPLACE('Hello World','World','SQL');
SELECT REVERSE('MYSQL');
```

