-- CREATE DATABASE
CREATE DATABASE CustomerDB;
USE CustomerDB;


-- CREATE CUSTOMER TABLE
CREATE TABLE Customers (
    CustomerID INT PRIMARY KEY AUTO_INCREMENT,
    FirstName VARCHAR(50),
    LastName VARCHAR(50),
    Email VARCHAR(100),
    Phone VARCHAR(15),
    City VARCHAR(50),
    Address VARCHAR(200),
    RegisteredDate DATE
);


