-- 1. PREVENT NEGATIVE STOCK
-- BEFORE UPDATE TRIGGER

DELIMITER //

CREATE TRIGGER Prevent_Negative_Stock
BEFORE UPDATE ON Products
FOR EACH ROW
BEGIN
    IF NEW.stock_quantity < 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Stock quantity cannot be negative';
    END IF;
END //

DELIMITER ;


-- TEST NEGATIVE STOCK

UPDATE Products
SET stock_quantity = -5
WHERE product_id = 1;


-- 2. AUDIT PRICE CHANGES
-- AFTER UPDATE TRIGGER

DELIMITER //

CREATE TRIGGER Audit_Price_Changes
AFTER UPDATE ON Products
FOR EACH ROW
BEGIN
    IF OLD.price <> NEW.price THEN
        INSERT INTO Inventory_Audit
        (product_id, action_type, old_value, new_value)
        VALUES
        (NEW.product_id, 'Price Updated',
         OLD.price, NEW.price);
    END IF;
END //

DELIMITER ;


-- TEST PRICE CHANGE

UPDATE Products
SET price = 55000
WHERE product_id = 1;


-- CHECK PRICE AUDIT

SELECT * FROM Inventory_Audit;


-- 3. AUTO-UPDATE STATUS TO OUT OF STOCK
-- BEFORE UPDATE TRIGGER

DELIMITER //

CREATE TRIGGER Update_Product_Status
BEFORE UPDATE ON Products
FOR EACH ROW
BEGIN
    IF NEW.stock_quantity = 0 THEN
        SET NEW.status = 'Out of Stock';
    ELSE
        SET NEW.status = 'Available';
    END IF;
END //

DELIMITER ;


-- TEST STOCK ZERO

UPDATE Products
SET stock_quantity = 0
WHERE product_id = 2;


-- CHECK PRODUCT STATUS

SELECT * FROM Products;


-- 4. ENFORCE UPPERCASE PRODUCT NAMES
-- BEFORE INSERT TRIGGER

DELIMITER //

CREATE TRIGGER Uppercase_Product_Name
BEFORE INSERT ON Products
FOR EACH ROW
BEGIN
    SET NEW.name = UPPER(NEW.name);
END //

DELIMITER ;


