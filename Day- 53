-- CREATE DATABASE
CREATE DATABASE CustomerDB;
USE CustomerDB;


-- 1. CREATE CUSTOMER TABLE
CREATE TABLE Customer (
    Customer_ID INT PRIMARY KEY AUTO_INCREMENT,
    Name VARCHAR(100),
    Mobile_No VARCHAR(15),
    Address VARCHAR(200),
    Bill_Amount DECIMAL(10,2),
    Bill_Date DATE
);


-- INSERT SAMPLE RECORDS
INSERT INTO Customer
(Name, Mobile_No, Address, Bill_Amount, Bill_Date)
VALUES
('Vijay', '9876543210', 'Thanjavur', 1500, '2026-10-01'),
('Arun', '9876543211', 'Chennai', 2500, '2026-10-05'),
