<script>

// 1. CLASS AND CONSTRUCTOR

class Student {

    constructor(name, age) {
        this.name = name;
        this.age = age;
    }

    display() {
        return "Name: " + this.name + "<br>Age: " + this.age;
    }
}

function classExample() {

    let s1 = new Student("Vijay", 21);

    document.getElementById("output1").innerHTML =
    s1.display();
}


// 2. REST, SPREAD AND DEFAULT PARAMETER

function add(...numbers) {
    return numbers;
}

function greet(name = "Student") {
    return "Hello " + name;
}

function operatorExample() {

    let a = [10, 20, 30];

    let b = [...a, 40, 50];

    document.getElementById("output2").innerHTML =
    "Rest: " + add(10, 20, 30) +
    "<br>Spread: " + b +
    "<br>Default Parameter: " + greet();
}


// 3. DOM EVENTS

function changeText() {

    document.getElementById("demo").innerHTML =
    "Welcome to JavaScript";

}


// 4. INHERITANCE

class Animal {

    eat() {
        return "Animal is eating";
    }
}

class Dog extends Animal {

    bark() {
        return "Dog is barking";
    }
}

function inheritanceExample() {

    let d1 = new Dog();

    document.getElementById("output4").innerHTML =
    d1.eat() + "<br>" + d1.bark();
}


// 5. POLYMORPHISM

class AnimalSound {

    sound() {
        return "Animal makes a sound";
    }
}

class DogSound extends AnimalSound {

    sound() {
        return "Dog barks";
    }
}

class CatSound extends AnimalSound {

    sound() {
        return "Cat meows";
    }
}

function polymorphismExample() {

    let d = new DogSound();
    let c = new CatSound();

    document.getElementById("output5").innerHTML =
    d.sound() + "<br>" + c.sound();
}


// 6. LOCAL STORAGE AND SESSION STORAGE

function storageExample() {

    localStorage.setItem("name", "Vijay");

    sessionStorage.setItem("course", "JavaScript");

    document.getElementById("output6").innerHTML =
    "Local Storage: " + localStorage.getItem("name") +
    "<br>Session Storage: " + sessionStorage.getItem("course");

}


// 7. EVENT LISTENER

document.getElementById("eventBtn").addEventListener("click", function() {

    document.getElementById("output7").innerHTML =
    "Button Clicked Successfully";

});


// 8. CALLBACK FUNCTION

function display(name) {

    return "Hello " + name;

}

function student(callback) {

    let name = "Vijay";

    return callback(name);

}

function callbackExample() {

    document.getElementById("output8").innerHTML =
    student(display);

}


// 9. PROMISES

function promiseExample() {

    let promise = new Promise(function(resolve, reject) {

        let success = true;

        if (success) {
            resolve("Task Completed Successfully");
        }
        else {
            reject("Task Failed");
        }

    });

    promise.then(function(result) {

        document.getElementById("output9").innerHTML = result;

    });

    promise.catch(function(error) {

        document.getElementById("output9").innerHTML = error;

    });

}


// 10. ASYNC AND AWAIT

function getData() {

    return new Promise(function(resolve) {

        resolve("Data Received Successfully");

    });

}

async function asyncExample() {

    let result = await getData();

    document.getElementById("output10").innerHTML = result;

}

</script>

</body>
</html>
