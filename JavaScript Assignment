<!-- 4. INHERITANCE -->

<div class="box">
    <h2>4. Inheritance</h2>

    <p>Inheritance allows one class to access another class properties and methods.</p>

    <button onclick="inheritanceExample()">Run Example</button>

    <p id="output4"></p>
</div>


<!-- 5. POLYMORPHISM -->

<div class="box">
    <h2>5. Polymorphism</h2>

    <p>Polymorphism means one method name with different behaviours.</p>

    <button onclick="polymorphismExample()">Run Example</button>

    <p id="output5"></p>
</div>


