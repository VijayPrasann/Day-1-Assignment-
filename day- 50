-- ==========================================
-- Q26. EMPLOYEES EARNING MORE THAN AVERAGE SALARY
-- ==========================================

SELECT *
FROM Employees
WHERE salary > (
    SELECT AVG(salary)
    FROM Employees
);


-- ==========================================
-- Q27. EMPLOYEES IN ENGINEERING DEPARTMENT
-- WITHOUT EXPLICIT JOIN
-- ==========================================

SELECT *
FROM Employees
WHERE dept_id = (
    SELECT dept_id
    FROM Departments
    WHERE dept_name = 'Engineering'
);


-- ==========================================
-- Q28. EMPLOYEES WORKING ON AT LEAST ONE PROJECT
-- ==========================================

SELECT emp_name
FROM Employees
WHERE emp_id IN (
    SELECT emp_id
    FROM Employee_Projects
);


-- ==========================================
-- Q29. EMPLOYEES NOT WORKING ON ANY PROJECT
-- ==========================================

SELECT emp_name
FROM Employees
WHERE emp_id NOT IN (
    SELECT emp_id
    FROM Employee_Projects
);


-- ==========================================
-- Q30. PROJECT WITH HIGHEST BUDGET
-- ==========================================

SELECT *
FROM Projects
WHERE budget = (
    SELECT MAX(budget)
    FROM Projects
);


-- ==========================================
-- Q31. DEPARTMENTS WITH HIGHER THAN AVERAGE
-- PROJECT BUDGET ALLOCATION
-- ==========================================

SELECT dept_name
FROM Departments
WHERE dept_id IN (
    SELECT dept_id
    FROM Projects
    GROUP BY dept_id
    HAVING AVG(budget) > (
        SELECT AVG(budget)
        FROM Projects
    )
);


-- ==========================================
-- Q32. EMPLOYEES EARNING MORE THAN
-- MAXIMUM MARKETING DEPARTMENT SALARY
-- ==========================================

SELECT *
FROM Employees
WHERE salary > (
    SELECT MAX(salary)
    FROM Employees
    WHERE dept_id = (
        SELECT dept_id
        FROM Departments
        WHERE dept_name = 'Marketing'
    )
);


-- ==========================================
-- Q33. CORRELATED SUBQUERY
-- EMPLOYEES EARNING MORE THAN OWN
-- DEPARTMENT AVERAGE SALARY
-- ==========================================

SELECT e.emp_name, e.salary, e.dept_id
FROM Employees e
WHERE e.salary > (
    SELECT AVG(e2.salary)
    FROM Employees e2
    WHERE e2.dept_id = e.dept_id
);


-- ==========================================
-- Q34. DEPARTMENTS HAVING EMPLOYEES
-- USING EXISTS
-- ==========================================

SELECT dept_name
FROM Departments d
WHERE EXISTS (
    SELECT 1
    FROM Employees e
    WHERE e.dept_id = d.dept_id
);


-- ==========================================
-- Q35. DEPARTMENTS WITHOUT PROJECTS
-- USING NOT EXISTS
-- ==========================================

SELECT dept_name
FROM Departments d
WHERE NOT EXISTS (
    SELECT 1
    FROM Projects p
    WHERE p.dept_id = d.dept_id
);


-- ==========================================
-- Q36. EMPLOYEE NAME WITH TOTAL COMPANY PAYROLL
-- SCALAR SUBQUERY
-- ==========================================

SELECT
    emp_name,
    salary,
    (SELECT SUM(salary) FROM Employees)
    AS Total_Company_Payroll
FROM Employees;


-- ==========================================
-- Q37. OLDEST EMPLOYEE BASED ON HIRE DATE
-- ==========================================

SELECT *
FROM Employees
WHERE hire_date = (
    SELECT MIN(hire_date)
    FROM Employees
);


-- ==========================================
-- Q38. SECOND HIGHEST SALARY
-- ==========================================

SELECT MAX(salary) AS Second_Highest_Salary
FROM Employees
WHERE salary < (
    SELECT MAX(salary)
    FROM Employees
);


-- ==========================================
-- Q39. PROJECTS WITH BUDGET GREATER THAN
-- TOTAL SALES DEPARTMENT PROJECT BUDGET
-- ==========================================

SELECT *
FROM Projects
WHERE budget > (
    SELECT SUM(budget)
    FROM Projects
    WHERE dept_id = (
        SELECT dept_id
        FROM Departments
        WHERE dept_name = 'Sales'
    )
);


-- ==========================================
-- Q40. EMPLOYEES WHOSE MANAGER WORKS
-- IN A DIFFERENT DEPARTMENT
-- ==========================================

SELECT *
FROM Employees e
WHERE e.manager_id IS NOT NULL
AND e.dept_id <> (
    SELECT m.dept_id
    FROM Employees m
    WHERE m.emp_id = e.manager_id
);


-- ==========================================
-- Q41. DEPARTMENT HAVING HIGHEST NUMBER
-- OF EMPLOYEES
-- ==========================================

SELECT dept_name
FROM Departments
WHERE dept_id IN (
    SELECT dept_id
    FROM Employees
    GROUP BY dept_id
    HAVING COUNT(*) = (
        SELECT MAX(emp_count)
        FROM (
            SELECT COUNT(*) AS emp_count
            FROM Employees
            GROUP BY dept_id
        ) AS temp
    )
);


-- ==========================================
-- Q42. EMPLOYEES WORKING ON PROJECT
-- WITH LONGEST HOURS LOGGED
-- ==========================================

SELECT emp_name
FROM Employees
WHERE emp_id IN (
    SELECT emp_id
    FROM Employee_Projects
    WHERE hours_worked = (
        SELECT MAX(hours_worked)
        FROM Employee_Projects
    )
);


-- ==========================================
-- Q43. DEPARTMENTS LOCATED IN CITIES
-- STARTING WITH NEW OR SAN
-- ==========================================

SELECT *
FROM Departments
WHERE dept_id IN (
    SELECT dept_id
    FROM Departments
    WHERE location LIKE 'New%'
       OR location LIKE 'San%'
);


-- ==========================================
-- Q44. EMPLOYEES EARNING MORE THAN ANY
-- EMPLOYEE HIRED IN 2024
-- ==========================================

SELECT *
FROM Employees
WHERE salary > ANY (
    SELECT salary
    FROM Employees
    WHERE YEAR(hire_date) = 2024
);


-- ==========================================
-- Q45. MANAGERS SUPERVISING AT LEAST
-- TWO EMPLOYEES
-- ==========================================

SELECT emp_name
FROM Employees
WHERE emp_id IN (
    SELECT manager_id
    FROM Employees
    WHERE manager_id IS NOT NULL
    GROUP BY manager_id
    HAVING COUNT(*) >= 2
);


-- ==========================================
-- Q46. PROJECTS WITH BUDGET LOWER THAN
-- COMPANY AVERAGE PROJECT BUDGET
-- ==========================================

SELECT project_name, budget
FROM Projects
WHERE budget < (
    SELECT AVG(budget)
    FROM Projects
);


-- ==========================================
-- Q47. EMPLOYEES WHO ARE THE ONLY ONES
-- WORKING ON THEIR SPECIFIC PROJECT
-- ==========================================

SELECT emp_name
FROM Employees
WHERE emp_id IN (
    SELECT emp_id
    FROM Employee_Projects
    WHERE project_id IN (
        SELECT project_id
        FROM Employee_Projects
        GROUP BY project_id
        HAVING COUNT(*) = 1
    )
);


-- ==========================================
-- Q48. EMPLOYEE SALARY DIFFERENCE
-- FROM DEPARTMENT AVERAGE
-- SUBQUERY IN SELECT CLAUSE
-- ==========================================

SELECT
    emp_name,
    salary,
    salary - (
        SELECT AVG(e2.salary)
        FROM Employees e2
        WHERE e2.dept_id = e1.dept_id
    ) AS Salary_Difference
FROM Employees e1;


-- ==========================================
-- Q49. DEPARTMENT WITH MINIMUM TOTAL PAYROLL
-- ==========================================

SELECT
    d.dept_name,
    COALESCE(SUM(e.salary), 0) AS Total_Payroll
FROM Departments d
LEFT JOIN Employees e
    ON d.dept_id = e.dept_id
GROUP BY d.dept_id, d.dept_name
HAVING COALESCE(SUM(e.salary), 0) = (
    SELECT MIN(total_payroll)
    FROM (
        SELECT
            d2.dept_id,
            COALESCE(SUM(e2.salary), 0) AS total_payroll
        FROM Departments d2
        LEFT JOIN Employees e2
            ON d2.dept_id = e2.dept_id
        GROUP BY d2.dept_id
    ) AS temp
);


-- ==========================================
-- Q50. PROJECTS HAVING AT LEAST ONE
-- ENGINEERING DEPARTMENT EMPLOYEE
-- ==========================================

SELECT project_name
FROM Projects p
WHERE EXISTS (
    SELECT 1
    FROM Employee_Projects ep
    WHERE ep.project_id = p.project_id
    AND ep.emp_id IN (
        SELECT emp_id
        FROM Employees
        WHERE dept_id = (
            SELECT dept_id
            FROM Departments
            WHERE dept_name = 'Engineering'
        )
    )
);


