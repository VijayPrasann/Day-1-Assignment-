
<!DOCTYPE html>
<html>
<head>
    <title>Bootstrap Assignment</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<!-- 1. Responsive Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
<div class="container">
    <a class="navbar-brand" href="#">ABC Institute</a>

    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menu">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="#courses">Products</a></li>
            <li class="nav-item"><a class="nav-link" href="#services">Services</a></li>
            <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
            <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
        </ul>
    </div>
</div>
</nav>

<!-- 2. Training Institute Page -->
<div class="container mt-4" id="home">

    <h1 class="text-center">Welcome to ABC Training Institute</h1>

    <img src="https://placehold.co/1000x300"
         class="img-fluid rounded w-100 mt-3">

    <h3 class="mt-4" id="about">About Our Institute</h3>
    <p>We provide quality training in programming,
    web development and software technologies.</p>

    <div class="row mt-4" id="services">

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h4>Courses</h4>
                <p>Python, Java, React and Web Development.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h4>Trainers</h4>
                <p>Experienced trainers provide practical training.</p>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card p-3">
                <h4>Placements</h4>
                <p>We provide placement training and support.</p>
            </div>
        </div>

    </div>

<!-- 3. Four Course Cards -->
    <h2 class="text-center mt-5" id="courses">Our Courses</h2>

    <div class="row mt-3">

        <div class="col-md-3 mb-3">
            <div class="card">
                <img src="https://placehold.co/300x150" class="card-img-top">
                <div class="card-body">
                    <h5>Python</h5>
                    <p>Duration: 3 Months</p>
                    <p>Fee: ₹5000</p>
                    <button class="btn btn-primary">Enroll</button>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card">
                <img src="https://placehold.co/300x150" class="card-img-top">
                <div class="card-body">
                    <h5>Java</h5>
                    <p>Duration: 4 Months</p>
                    <p>Fee: ₹6000</p>
                    <button class="btn btn-primary">Enroll</button>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card">
                <img src="https://placehold.co/300x150" class="card-img-top">
                <div class="card-body">
                    <h5>React</h5>
                    <p>Duration: 2 Months</p>
                    <p>Fee: ₹4000</p>
                    <button class="btn btn-primary">Enroll</button>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card">
                <img src="https://placehold.co/300x150" class="card-img-top">
                <div class="card-body">
                    <h5>Web Design</h5>
                    <p>Duration: 3 Months</p>
                    <p>Fee: ₹4500</p>
                    <button class="btn btn-primary">Enroll</button>
                </div>
            </div>
        </div>

    </div>

<!-- 4. Employee Table -->
    <h2 class="mt-5">Employee Details</h2>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Salary</th>
                </tr>
            </thead>

            <tbody>
                <tr><td>1</td><td>Vijay</td><td>IT</td><td>25000</td></tr>
                <tr><td>2</td><td>Arun</td><td>HR</td><td>30000</td></tr>
                <tr><td>3</td><td>Ravi</td><td>Finance</td><td>28000</td></tr>
                <tr><td>4</td><td>Priya</td><td>IT</td><td>35000</td></tr>
                <tr><td>5</td><td>Ajay</td><td>Sales</td><td>22000</td></tr>
                <tr><td>6</td><td>Divya</td><td>HR</td><td>32000</td></tr>
            </tbody>

        </table>
    </div>

<!-- 5. Employee Registration Form -->
    <h2 class="mt-5" id="contact">Employee Registration</h2>

    <form class="mb-5">

        <label class="form-label">Employee Name</label>
        <input type="text" class="form-control mb-3" placeholder="Enter Name">

        <label class="form-label">Email</label>
        <input type="email" class="form-control mb-3" placeholder="Enter Email">

        <label class="form-label">Mobile Number</label>
        <input type="tel" class="form-control mb-3" placeholder="Enter Mobile Number">

        <label class="form-label">Department</label>
        <select class="form-select mb-3">
            <option>Select Department</option>
            <option>IT</option>
            <option>HR</option>
            <option>Finance</option>
            <option>Sales</option>
        </select>

        <label class="form-label">Gender</label><br>
        <input type="radio" name="gender"> Male
        <input type="radio" name="gender" class="ms-3"> Female
        <input type="radio" name="gender" class="ms-3"> Other

        <label class="form-label d-block mt-3">Date of Joining</label>
        <input type="date" class="form-control mb-3">

        <button type="submit" class="btn btn-success">Submit</button>

    </form>

</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center p-3">
    © 2026 ABC Training Institute. All Rights Reserved.
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
